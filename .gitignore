.env
.env.*
!.env.example

# 数据库脚本（只在本地初始化使用，不提交）
database.sql

# 工具缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 依赖目录（不应提交，npm install 即可重建）
node_modules/

# 前端
frontend/node_modules/
frontend/dist/
# Vue 项目的实际构建产物目录
frontend/xwzx-news/dist/

# 用户上传的头像等文件，属于运行时数据，不提交
static/avatars/

# 新闻配图为本地演示资产，不提交（生产环境应使用对象存储/CDN）
frontend/xwzx-news/public/covers/news/

