# 数据库连接配置模板
# 使用方法：复制本文件为 .env，再填入真实值
#   cp .env.example .env
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=news_app

# 是否打印执行的 SQL：1 打开，0 关闭
DB_ECHO=0

# Redis 缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
# 本项目使用 1 号库，避免和其他应用的 0 号库混用
REDIS_DB=1
# 没有密码就留空
REDIS_PASSWORD=
